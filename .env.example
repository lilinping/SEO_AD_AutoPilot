# =============================================================================
# SEO-AD AutoPilot — 环境变量配置
# =============================================================================
# 使用方法:
#   1. 复制此文件: cp .env.example .env
#   2. 填入必填项（标注 ★ 的项目）
#   3. 可选项可保持默认值或留空
#
# 安全注意:
#   - .env 已加入 .gitignore，绝对不要提交到代码仓库！
#   - 生产环境建议使用密钥管理服务（AWS Secrets Manager / Vault 等）
# =============================================================================


# ─────────────────────────────────────────────────────────────────────────────
# 【1】应用基础配置
# ─────────────────────────────────────────────────────────────────────────────

# 运行环境: development | testing | production
SEO_AD_BOT_ENVIRONMENT=development

# API 服务器地址和端口
SEO_AD_BOT_HOST=127.0.0.1
SEO_AD_BOT_PORT=8000

# 应用密钥（生产环境请生成随机值: python -c "import secrets; print(secrets.token_hex(32))"）
SEO_AD_BOT_SECRET_KEY=change-me-in-production-use-secrets-token-hex-32

# 日志级别: DEBUG | INFO | WARNING | ERROR
SEO_AD_BOT_LOG_LEVEL=INFO

# 允许的跨域来源（逗号分隔，生产环境请限制为实际域名）
SEO_AD_BOT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Worker 并发数（0 = 自动，按 CPU 核心数）
SEO_AD_BOT_WORKERS=0


# ─────────────────────────────────────────────────────────────────────────────
# 【2】数据库配置
# ─────────────────────────────────────────────────────────────────────────────

# ★ 数据库连接 URL
# SQLite（开发推荐）: sqlite+aiosqlite:///./seo_ad_bot.db
# PostgreSQL（生产推荐）: postgresql+asyncpg://user:password@localhost:5432/seo_ad_bot
DATABASE_URL=sqlite+aiosqlite:///./seo_ad_bot.db

# 数据库连接池配置（SQLite 不需要调整）
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30


# ─────────────────────────────────────────────────────────────────────────────
# 【3】Redis 缓存配置（AGT-004 Agent 缓存）
# ─────────────────────────────────────────────────────────────────────────────

# Redis 连接 URL（留空则使用进程内存缓存，仅适合单进程开发环境）
# 本地 Redis: redis://localhost:6379/0
# 带密码:     redis://:your-password@localhost:6379/0
# Redis Cluster: rediss://username:password@cluster-host:6380/0
REDIS_URL=
SEO_AD_BOT_REDIS_URL=

# Agent 缓存默认 TTL（秒），0 = 使用各 Agent 类型的独立配置
SEO_AD_BOT_CACHE_TTL=0

# 是否启用 Agent 结果缓存（false 用于调试/dry_run）
SEO_AD_BOT_CACHE_ENABLED=true


# ─────────────────────────────────────────────────────────────────────────────
# 【4】LLM / AI 模型配置
# ─────────────────────────────────────────────────────────────────────────────

# ★ OpenAI API Key（主要 LLM 提供商）
# 获取: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI 使用的模型（支持 gpt-4o, gpt-4-turbo, gpt-3.5-turbo 等）
OPENAI_MODEL=gpt-4o

# OpenAI API Base URL（使用代理或兼容 API 时修改）
OPENAI_API_BASE=https://api.openai.com/v1

# OpenAI 组织 ID（可选，用于团队账单）
OPENAI_ORG_ID=

# ── Anthropic Claude（可选备用 LLM）──────────────────────────────────────────
# 获取: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Claude 模型（claude-3-5-sonnet-20241022 | claude-3-opus-20240229）
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ── Google Gemini（可选备用 LLM）─────────────────────────────────────────────
# 获取: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-1.5-pro

# ── 本地 Ollama（可选本地 LLM）───────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── LLM 请求参数 ──────────────────────────────────────────────────────────────
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.3
LLM_REQUEST_TIMEOUT=120
LLM_MAX_RETRIES=3

# Per-user Token 配额（0 = 不限制）
LLM_USER_TOKEN_QUOTA_DAILY=0


# ─────────────────────────────────────────────────────────────────────────────
# 【5】SEO 数据源 API Keys
# ─────────────────────────────────────────────────────────────────────────────

# ── Google Search Console & Analytics ────────────────────────────────────────
# 获取: https://console.cloud.google.com/apis/credentials
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=
GOOGLE_ANALYTICS_PROPERTY_ID=

# ── Google Search API（自定义搜索）───────────────────────────────────────────
# 获取: https://developers.google.com/custom-search/v1/introduction
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_ENGINE_ID=

# ── Bing Search API ───────────────────────────────────────────────────────────
# 获取: https://portal.azure.com/ → Cognitive Services → Bing Search
BING_SEARCH_API_KEY=
BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/search

# ── Ahrefs（SEO 数据）─────────────────────────────────────────────────────────
# 获取: https://ahrefs.com/api
AHREFS_API_KEY=
AHREFS_API_V2_KEY=

# ── SEMrush ───────────────────────────────────────────────────────────────────
# 获取: https://www.semrush.com/api-documentation/
SEMRUSH_API_KEY=

# ── Moz ───────────────────────────────────────────────────────────────────────
# 获取: https://moz.com/products/api
MOZ_ACCESS_ID=
MOZ_SECRET_KEY=

# ── DataForSEO（关键词/SERP 数据）────────────────────────────────────────────
# 获取: https://dataforseo.com/
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ── SerpAPI ───────────────────────────────────────────────────────────────────
# 获取: https://serpapi.com/manage-api-key
SERPAPI_KEY=

# ── ValueSERP ─────────────────────────────────────────────────────────────────
VALUESERP_API_KEY=

# ── Brave Search API（隐私友好搜索）─────────────────────────────────────────
# 获取: https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# 【6】广告平台 API Keys
# ─────────────────────────────────────────────────────────────────────────────

# ── Google Ads ────────────────────────────────────────────────────────────────
# 获取: https://developers.google.com/google-ads/api/docs/get-started/dev-token
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# ── Meta (Facebook) Ads ──────────────────────────────────────────────────────
# 获取: https://developers.facebook.com/
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# ── Microsoft Advertising (Bing Ads) ─────────────────────────────────────────
# 获取: https://docs.microsoft.com/en-us/advertising/guides/get-started
MICROSOFT_ADS_CLIENT_ID=
MICROSOFT_ADS_CLIENT_SECRET=
MICROSOFT_ADS_DEVELOPER_TOKEN=
MICROSOFT_ADS_REFRESH_TOKEN=

# ── 字节跳动巨量引擎（TikTok/抖音广告）──────────────────────────────────────
# 获取: https://ads.tiktok.com/marketing_api/
BYTEDANCE_APP_ID=
BYTEDANCE_APP_SECRET=
TIKTOK_ACCESS_TOKEN=

# ── 百度推广 ──────────────────────────────────────────────────────────────────
BAIDU_ADS_USERNAME=
BAIDU_ADS_PASSWORD=
BAIDU_ADS_TOKEN=

# ── 腾讯广告 ─────────────────────────────────────────────────────────────────
TENCENT_ADS_APP_ID=
TENCENT_ADS_APP_SECRET=


# ─────────────────────────────────────────────────────────────────────────────
# 【7】网站分析 & 监控
# ─────────────────────────────────────────────────────────────────────────────

# ── PageSpeed / Core Web Vitals ───────────────────────────────────────────────
# 获取: https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=

# ── Lighthouse CI ─────────────────────────────────────────────────────────────
LHCI_TOKEN=

# ── Cloudflare（CDN/性能分析）────────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# ── Datadog（APM/监控，可选）─────────────────────────────────────────────────
DATADOG_API_KEY=
DATADOG_APP_KEY=

# ── Sentry（错误追踪）────────────────────────────────────────────────────────
# 获取: https://sentry.io/settings/account/api/auth-tokens/
SENTRY_DSN=

# ── Prometheus 端点认证（生产环境建议启用）────────────────────────────────────
SEO_AD_BOT_METRICS_TOKEN=


# ─────────────────────────────────────────────────────────────────────────────
# 【8】爬虫 & 代理配置
# ─────────────────────────────────────────────────────────────────────────────

# HTTP 请求超时（秒）
SEO_AD_BOT_REQUEST_TIMEOUT=30

# 最大并发爬虫数
SEO_AD_BOT_MAX_CONCURRENT_CRAWLERS=5

# 爬虫 User-Agent
SEO_AD_BOT_USER_AGENT=SEO-AD-AutoPilot/1.0 (+https://github.com/your-org/seo-ad-bot)

# ── 代理池（SE-004）────────────────────────────────────────────────────────
# 代理 URL（留空则不使用代理）
# 格式: http://user:pass@proxy-host:port
SEO_AD_BOT_PROXY_URL=

# 代理池 API（支持 Brightdata / Oxylabs / Smartproxy）
PROXY_POOL_API_KEY=
PROXY_POOL_ENDPOINT=

# ── Playwright / Selenium（动态页面爬取）─────────────────────────────────────
PLAYWRIGHT_HEADLESS=true
SELENIUM_REMOTE_URL=


# ─────────────────────────────────────────────────────────────────────────────
# 【9】通知 & Webhook
# ─────────────────────────────────────────────────────────────────────────────

# ── Slack Webhook（任务完成通知）─────────────────────────────────────────────
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#seo-alerts

# ── 飞书机器人 Webhook ────────────────────────────────────────────────────────
FEISHU_WEBHOOK_URL=

# ── 企业微信机器人 Webhook ────────────────────────────────────────────────────
WECOM_WEBHOOK_URL=

# ── 邮件通知（SMTP）──────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@your-domain.com


# ─────────────────────────────────────────────────────────────────────────────
# 【10】功能开关 (Feature Flags)
# ─────────────────────────────────────────────────────────────────────────────

# 启用 GEO (Generative Engine Optimization) 功能
FEATURE_GEO_ENABLED=true

# 启用广告平台推荐
FEATURE_AD_RECOMMENDATIONS_ENABLED=true

# 启用 DebateEngine 第三轮（策略 vs 合规终裁）— AGT-005
FEATURE_DEBATE_ROUND3_ENABLED=false

# 启用 Skill 结果持久化到 artifact_store — SKL-005
FEATURE_SKILL_PERSISTENCE_ENABLED=false

# 启用搜索结果缓存 — SE-005
FEATURE_SEARCH_CACHE_ENABLED=true

# 启用中国市场搜索聚合（百度/360/搜狗）— SE-006
FEATURE_CN_SEARCH_ENABLED=false

# 启用 Prometheus 指标端点 — OPS-007
FEATURE_METRICS_ENABLED=true

# 启用 per-user Token 配额统计 — LLM-007
FEATURE_TOKEN_QUOTA_ENABLED=false
