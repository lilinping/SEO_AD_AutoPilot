FROM mcr.microsoft.com/playwright/python:v1.60.0-jammy

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY apps/ apps/

ENV PYTHONPATH=/app
ENV SEO_AD_BOT_VISUAL_FARM_ARTIFACT_DIR=/data

EXPOSE 8010

CMD ["python", "-m", "uvicorn", "apps.visual_farm.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8010"]
